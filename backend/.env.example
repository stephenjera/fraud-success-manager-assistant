# Postgres DSNs (ADR-0007: one cluster, two schemas, two roles).
# Each carries its own search_path so unqualified names resolve to the intended schema.
PG_DSN="postgresql://postgres:postgres@localhost:5433/fraud"
REFERENCE_DSN="postgresql://reference_readonly:reference_readonly@localhost:5433/fraud?options=-csearch_path%3Dreference"
APPSTATE_DSN="postgresql://app_rw:app_rw@localhost:5433/fraud?options=-csearch_path%3Dappstate"

# Local Postgres (docker compose, backend/docker-compose.yml) — dev-only credentials
POSTGRES_USER="postgres"
POSTGRES_PW="postgres"
POSTGRES_DB="fraud"
POSTGRES_INITDB_ARGS="--data-checksums"
PGADMIN_MAIL="pgadmin@example.com"
PGADMIN_PW="pgadmin"

LLM_PROVIDER="ollama"
LLM_MODEL="granite4.1:3b"
LLM_API_BASE="http://localhost:11434"
LLM_API_KEY=""
ORIGINS=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_BASE_URL="http://localhost:3000"